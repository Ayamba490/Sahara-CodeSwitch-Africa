# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROK_API_KEY / XAI_API_KEY: Optional xAI Grok API key from https://console.x.ai
# Can be used instead of or alongside Gemini for real-time code-switching analysis and polyglot translation.
GROK_API_KEY=""
XAI_API_KEY=""

# OPENROUTER_API_KEY: OpenRouter AI API key (https://openrouter.ai)
# Routes to state-of-the-art models (Llama 3.3 70B, Qwen 2.5 72B, DeepSeek) for African polyglot translation.
OPENROUTER_API_KEY=""

# SAHARA_API_KEY / INTRON_API_KEY: Sahara Voice API key from https://voice.intron.io (Developer tab)
# Used for real-time speech-to-text with African code-switching models.
SAHARA_API_KEY=""
INTRON_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
